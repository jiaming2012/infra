# Temporal Infrastructure — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.

# ---------------------------------------------------------------------------
# External PostgreSQL connection (Metabase's Postgres instance on the WSL host)
# ---------------------------------------------------------------------------
# POSTGRES_HOST options:
#   - 'host-gateway'  : resolves to Docker host's bridge IP (recommended, requires extra_hosts in compose)
#   - '172.17.0.1'    : default Docker bridge gateway (use if host-gateway doesn't work)
#   - explicit IP     : the WSL2 host IP (run: hostname -I | awk '{print $1}')
POSTGRES_HOST=host-gateway
POSTGRES_PORT=5432
POSTGRES_USER=temporal
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ---------------------------------------------------------------------------
# Temporal Broadcast Address
# ---------------------------------------------------------------------------
# Address the server's own services (frontend/history/matching) advertise to
# EACH OTHER on the membership ring. Workers never see it — they dial the
# published :7233 (LAN IP, router public IP, or Tailscale, as before).
#
# Leave it unset: the entrypoint uses the container's own IP, which is right on
# any host and any network. A host LAN IP here crash-loops the server as soon as
# the host changes networks (ringpop cannot join its own advertised address).
#
# Set it only to pin a specific, container-reachable address.
# TEMPORAL_BROADCAST_ADDRESS=

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
# Admin password for Grafana Web UI (http://localhost:3000)
# Default: admin (change for any non-local access)
GRAFANA_ADMIN_PASSWORD=admin
